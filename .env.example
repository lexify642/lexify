# Supabase — Project Settings → API.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"

# AI provider (optional). Leave unset to run with AI sections marked
# "Not yet generated". Supported: openai | anthropic | gemini
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
