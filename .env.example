# Supabase — Project Settings → API. SUPABASE_URL/SUPABASE_ANON_KEY (no
# NEXT_PUBLIC_ prefix) are the original server-only client used by the
# case-research feature (lib/supabase.js) — keep both sets even though
# they point at the same project, since NEXT_PUBLIC_* is what @supabase/ssr
# needs to build a browser client for real login sessions.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"

# Service-role key — Project Settings → API → service_role (secret!). Used
# ONLY by server-only code (lib/supabase/admin.js) for admin-only operations:
# minting a real session after OTP verification, and Admin → Users invites.
# NEVER prefix this with NEXT_PUBLIC_, never import lib/supabase/admin.js
# from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (optional). Leave unset to run with AI sections marked
# "Not yet generated". Supported: openai | anthropic | gemini
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Resend — required for email-OTP login (lib/auth/otp.js) and the Draft
# Review "Send for Review" flow (lib/email/draftReview.js). Get a key at
# resend.com/api-keys. Leave unset to see a clean "not configured" error
# instead of a crash when either flow tries to send.
RESEND_API_KEY=
# Optional — defaults to "LEXIFYI <onboarding@resend.dev>" (Resend's shared
# sandbox sender, which can only deliver to your own Resend account email).
# Set this to a verified domain address (e.g. "LEXIFYI <noreply@lexifyi.com>")
# once that domain is verified in Resend, to send to arbitrary recipients.
RESEND_FROM_EMAIL=
