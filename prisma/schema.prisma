// Cases (legal case research) module schema.
// One wide, nullable-friendly LegalCase table so future court datasets
// (District Courts, NCLT, ITAT, CAT, ...) slot in via `datasetSource` without
// any structural change. AI outputs live in a separate 1:1 table so the
// original judgment metadata is never overwritten and analysis can be
// regenerated independently (see lib/ai).

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model LegalCase {
  id             String  @id @default(cuid())
  sourceId       Int?
  datasetSource  String // "hc" | "sc" today; "district_court" | "nclt" | "itat" | "cat" ... later
  caseMetadataId String?
  parserRecordId String // stable content-hash id from the source dataset — dedup key
  ingestionSplit String?

  caseTitle       String
  partyPetitioner String?
  partyRespondent String?
  partyCaption    String?

  docketNumber String?
  cnrNumber    String?

  neutralCitation   String?
  lawReportCitation String?

  courtName String
  courtCode String?
  benchName String?

  presidingJudge   String?
  coramMembers     String[] @default([])
  coramMembersText String?

  decisionDate     DateTime?
  registrationDate DateTime?
  citationYear     Int?
  decisionYear     Int?

  dispositionText String?

  sourceRelativePath  String?
  sourcePathYear      String?
  sourcePathCourtCode String?
  sourcePathBench     String?
  sourceFilename      String?

  sourcePdfS3Url  String?
  sourceJsonS3Url String?

  languageCodes String[] @default([])

  indexableText    String?
  headnoteText     String?
  fullJudgmentText String? // reserved for a future PDF/full-text extraction pipeline

  referencedActs     String[] @default([])
  referencedSections String[] @default([])
  keywords           String[] @default([])

  normalizedRecordJson Json?
  parserJson           Json?
  qualityJson          Json?

  // Postgres full-text search column, added + indexed via a hand-written
  // migration (no Prisma schema DSL equivalent for generated tsvector columns).
  // This is the extension point for semantic/vector search later.
  searchVector Unsupported("tsvector")?

  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aiAnalysis    LegalCaseAiAnalysis?
  citationsFrom LegalCaseCitation[]  @relation("CitationFrom")
  citationsTo   LegalCaseCitation[]  @relation("CitationTo")

  @@unique([datasetSource, parserRecordId])
  @@index([courtName])
  @@index([presidingJudge])
  @@index([citationYear])
  @@index([decisionYear])
  @@index([docketNumber])
  @@index([cnrNumber])
  @@index([datasetSource])
  @@index([decisionDate])
  @@map("legal_cases")
}

enum AiAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED_NO_TEXT
}

model LegalCaseAiAnalysis {
  id     String    @id @default(cuid())
  caseId String    @unique
  case   LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  summary             String?
  facts                String?
  issues               String?
  argumentsPetitioner  String?
  argumentsRespondent  String?
  decision             String?
  ratioDecidendi       String?
  obiterDicta          String?

  keyTakeaways        String[] @default([])
  importantParagraphs Json? // [{ paragraphNumber, text }]
  aiKeywords          String[] @default([])
  readingTimeMinutes  Int?

  status        AiAnalysisStatus @default(PENDING)
  modelProvider String?
  modelName     String?
  promptVersion Int              @default(1) // bump to force regeneration after a model upgrade
  generatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("legal_case_ai_analysis")
}

enum CaseCitationRelationType {
  CITES
  CITED_BY
  SIMILAR
  RELATED
}

model LegalCaseCitation {
  id              String                   @id @default(cuid())
  fromCaseId      String
  fromCase        LegalCase                @relation("CitationFrom", fields: [fromCaseId], references: [id], onDelete: Cascade)
  toCaseId        String?
  toCase          LegalCase?               @relation("CitationTo", fields: [toCaseId], references: [id], onDelete: SetNull)
  citationTextRaw String
  relationType    CaseCitationRelationType @default(CITES)
  createdAt       DateTime                 @default(now())

  @@index([fromCaseId])
  @@index([toCaseId])
  @@map("legal_case_citations")
}
